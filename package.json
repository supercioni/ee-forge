{
  "name": "ee-forge",
  "version": "0.9.0",
  "private": true,
  "description": "EE FORGE — a visual scenario editor for EmptyEpsilon (2024.12.08 and 2026.09.22PR) that generates plain vanilla Lua",
  "license": "GPL-3.0-only",
  "engines": { "node": ">=20", "pnpm": ">=10" },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "build": "pnpm --filter \"@forge/desktop...\" run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "start": "pnpm --filter @forge/desktop start",
    "installer": "pnpm --filter @forge/desktop installer"
  },
  "devDependencies": { "typescript": "^5.6.3" }
}
