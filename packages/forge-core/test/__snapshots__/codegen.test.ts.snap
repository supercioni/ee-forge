exports[`golden output > matches the committed snapshot > scenario_forge_demo.lua 1`] = `
"-- Name: EE FORGE Demo — Corsair Ambush
-- Description: STEP 35 gate scenario. Exercises every layer of the forge on plain EmptyEpsilon: a custom faction, a custom ModelData, two custom ship templates (one derived with copy()), a map with orbits/zone/belt, and a narrative of beats plus edge-triggered rules.
-- Type: Basic
--
-- GENERATED BY EE FORGE — DO NOT EDIT
-- project forge_demo (scenario)
-- source  projects/forge_demo/project.json
-- sha256  test-hash
-- target  EE-2026.09.22PR
--
-- Edit the project document and build again. Hand edits here are
-- overwritten on the next build.

require("forge_demo_content.lua")
require("forge_demo_map.lua")

forge_demo_rt = {}
forge_demo_state = { vars = {}, obj_vars = {}, beat_idx = 1 }

function forge_demo_rt.player() return getPlayerShip(-1) end
function forge_demo_rt.alive(o) return o ~= nil and o:isValid() end

--- Handles for an action target: the player, one object, or a whole group.
function forge_demo_rt.targets(kind, key)
  if kind == "player" then
    local p = forge_demo_rt.player()
    if p == nil then return {} end
    return { p }
  elseif kind == "object" then
    local o = forge_demo_map.objects[key]
    if o == nil then return {} end
    return { o }
  end
  return forge_demo_map.groups[key] or {}
end

--- True only once an object has actually existed and then stopped being
--- valid — an object that was never spawned is not "destroyed".
function forge_demo_rt.destroyed(id)
  local o = forge_demo_map.objects[id]
  return o ~= nil and not o:isValid()
end

function forge_demo_rt.group_wiped(name)
  local g = forge_demo_map.groups[name]
  if g == nil or #g == 0 then return false end
  for _, o in ipairs(g) do
    if forge_demo_rt.alive(o) then return false end
  end
  return true
end

function forge_demo_rt.zone_contains(id)
  local z, p = forge_demo_map.objects[id], forge_demo_rt.player()
  if not forge_demo_rt.alive(z) or p == nil then return false end
  return z:isInside(p)
end

function forge_demo_rt.near_point(x, y, dist)
  local p = forge_demo_rt.player()
  if p == nil then return false end
  local px, py = p:getPosition()
  local dx, dy = px - x, py - y
  return (dx * dx + dy * dy) <= dist * dist
end

function forge_demo_rt.near_object(id, dist)
  local o = forge_demo_map.objects[id]
  if not forge_demo_rt.alive(o) then return false end
  local ox, oy = o:getPosition()
  return forge_demo_rt.near_point(ox, oy, dist)
end

--- Comms (ADR-0039). dlg holds one function per dialogue node; dlg_entries
--- maps a dialogue id to the node a hail opens on.
forge_demo_rt.dlg = {}
forge_demo_rt.dlg_entries = {}

function forge_demo_rt.dlg_entry(id)
  local nodes = forge_demo_rt.dlg[id]
  if nodes == nil then return nil end
  return nodes[forge_demo_rt.dlg_entries[id]]
end

--- Attach a dialogue to every handle in objs, or restore EE's own default
--- for the class when dialogue is nil.
---
--- setCommsScript("") does not restore anything — EE documents it as
--- *disabling* comms — and setCommsFunction takes precedence over any
--- script, so putting the default back means clearing the function first
--- and then selecting the default script from the ECS component profile.
--- EE 2026 no longer exposes typeName (API reference §16).
function forge_demo_rt.set_dialogue(objs, dialogue)
  for _, o in ipairs(objs) do
    if forge_demo_rt.alive(o) then
      if dialogue == nil then
        o:setCommsFunction(nil)
        if o.components.docking_bay and o.components.physics and o.components.physics.type == "static" then
          o:setCommsScript("comms_station.lua")
        else
          o:setCommsScript("comms_ship.lua")
        end
      else
        o:setCommsScript("")
        o:setCommsFunction(forge_demo_rt.dlg_entry(dialogue))
      end
    end
  end
end

--- The object hails the player, rather than waiting to be hailed. EE
--- returns whether Relay accepted; the scenario has no retry policy, so
--- the answer is deliberately dropped.
function forge_demo_rt.hail(id, text)
  local o, p = forge_demo_map.objects[id], forge_demo_rt.player()
  if forge_demo_rt.alive(o) and p ~= nil then o:sendCommsMessage(p, text) end
end

--- Replaced by the emitted scenario when the project declares dialogues.
function forge_demo_rt.install_dialogues() end

function forge_demo_rt.hull_fraction()
  local p = forge_demo_rt.player()
  if p == nil then return 1 end
  local max_hull = p:getHullMax()
  if max_hull == nil or max_hull <= 0 then return 1 end
  return p:getHull() / max_hull
end

function forge_demo_rt.system_health(name)
  local p = forge_demo_rt.player()
  if p == nil then return 1 end
  return p:getSystemHealth(name)
end

function forge_demo_rt.scanned_simple(id)
  local o, p = forge_demo_map.objects[id], forge_demo_rt.player()
  if not forge_demo_rt.alive(o) or p == nil then return false end
  return o:isScannedBy(p)
end

function forge_demo_rt.scanned_full(id)
  local o, p = forge_demo_map.objects[id], forge_demo_rt.player()
  if not forge_demo_rt.alive(o) or p == nil then return false end
  return o:isFullyScannedBy(p)
end

function forge_demo_rt.var_get(name) return forge_demo_state.vars[name] end

--- Variables belonging to one object, keyed by the project's own id.
--- Deliberately NOT fields on the EE handle: this table outlives the
--- object, so a rule can still ask what a ship's state was when it died.
function forge_demo_rt.obj_vars(id)
  local t = forge_demo_state.obj_vars[id]
  if t == nil then t = {}; forge_demo_state.obj_vars[id] = t end
  return t
end

function forge_demo_rt.obj_get(id, name) return forge_demo_rt.obj_vars(id)[name] end

function forge_demo_rt.run(label, fn)
  local ok, err = pcall(fn)
  if not ok then
    print("[forge] " .. label .. " failed: " .. tostring(err))
  end
end

-- === Variables ===
forge_demo_state.vars["alarm"] = 0
forge_demo_state.vars["briefed"] = false

-- === Object variables (declared on the objects that own them) ===
forge_demo_state.obj_vars["corsair_a"] = forge_demo_state.obj_vars["corsair_a"] or {}
forge_demo_state.obj_vars["corsair_a"]["alerted"] = false
forge_demo_state.obj_vars["corsair_b"] = forge_demo_state.obj_vars["corsair_b"] or {}
forge_demo_state.obj_vars["corsair_b"]["alerted"] = false

-- === Beats (time-keyed, in ascending order) ===
local beats = {
  {
    id = "arrival",
    at = 0,
    -- Arrival — Anchorage Control hails the ship
    fn = function()
      globalMessage("ANCHORAGE CONTROL: Atlantis, you are cleared to the inner approach.")
      for _, o in ipairs(forge_demo_rt.targets("player", nil)) do
        if forge_demo_rt.alive(o) then
          o:addToShipLog("Cleared to inner approach. Corsair activity reported in the belt.", "yellow")
        end
      end
      forge_demo_state.vars["briefed"] = true
    end,
  },
  {
    id = "warning",
    at = 45,
    -- T+45 — Control repeats the corsair warning
    fn = function()
      setBanner("CORSAIR ACTIVITY REPORTED — INNER APPROACH")
      addGMMessage("Player has been warned about the corsairs.")
    end,
  },
}

-- === Rules (edge-triggered: fire when the predicate turns true) ===
local rules = {
  {
    id = "spring_ambush",
    once = true,
    fired = false,
    was_true = false,
    -- Player enters the approach zone — corsairs decloak from the belt
    when = function()
      return (forge_demo_rt.zone_contains("approach_zone")) and (forge_demo_rt.var_get("briefed") == true)
    end,
    fn = function()
      forge_demo_map.spawn_group("ambush")
      forge_demo_rt.install_dialogues()
      for _, o in ipairs(forge_demo_rt.targets("player", nil)) do
        if forge_demo_rt.alive(o) then
          o:commandSetAlertLevel("red")
        end
      end
      globalMessage("Two contacts closing from the belt. Corsairs!", 8)
      forge_demo_state.vars["alarm"] = 1
      for _, o in ipairs(forge_demo_rt.targets("group", "ambush")) do
        if forge_demo_rt.alive(o) then
          o:orderAttack(forge_demo_map.objects["atlantis"])
        end
      end
      for _, o in ipairs(forge_demo_rt.targets("object", "corsair_b")) do
        if forge_demo_rt.alive(o) then
          o:orderFlyFormation(forge_demo_map.objects["corsair_a"], 900, -600)
        end
      end
      for _, id in ipairs({ "corsair_a", "corsair_b" }) do
        forge_demo_rt.obj_vars(id)["alerted"] = true
      end
    end,
  },
  {
    id = "ambush_cleared",
    once = true,
    fired = false,
    was_true = false,
    -- Both corsairs destroyed — the approach is clear
    when = function()
      return (forge_demo_rt.group_wiped("ambush")) and ((forge_demo_rt.var_get("alarm") or 0) >= 1)
    end,
    fn = function()
      globalMessage("ANCHORAGE CONTROL: Approach is clear. Well flown, Atlantis.")
      for _, o in ipairs(forge_demo_rt.targets("player", nil)) do
        if forge_demo_rt.alive(o) then
          o:addToShipLog("Corsair pair destroyed.", "green")
        end
      end
      victory("Human Navy")
    end,
  },
  {
    id = "hull_critical",
    once = true,
    fired = false,
    was_true = false,
    -- Hull below 30% — Control offers the station for repairs
    when = function()
      return (forge_demo_rt.hull_fraction() < 0.3)
    end,
    fn = function()
      globalMessage("ANCHORAGE CONTROL: Atlantis, dock at Anchorage Control for repairs.")
      for _, o in ipairs(forge_demo_rt.targets("player", nil)) do
        if forge_demo_rt.alive(o) then
          o:addToShipLog("Hull critical. Repair dock offered.", "red")
        end
      end
    end,
  },
  {
    id = "wing_breaks_off",
    once = true,
    fired = false,
    was_true = false,
    -- Alerted wing breaks off when the Atlantis is hurt
    when = function()
      return (forge_demo_rt.hull_fraction() < 0.4) and (forge_demo_rt.obj_get("corsair_a", "alerted") == true)
    end,
    fn = function()
      for _, o in ipairs(forge_demo_rt.targets("group", "ambush")) do
        if forge_demo_rt.alive(o) then
          o:orderRetreat(forge_demo_map.objects["anchorage"])
        end
      end
      globalMessage("The corsair wing is breaking off.", 6)
    end,
  },
}

-- === Dialogues (ADR-0039) ===
-- (none)

-- (no dialogues)

-- Attach the dialogues the map objects declare. Called from init() after
-- spawn() and again after every spawn_group, so a group that arrives
-- mid-scenario gets its conversations too. Idempotent.
forge_demo_rt.install_dialogues = function()
  -- (none)
end

--- Register the GM console buttons this project declares.
--- EE accepts addGMFunction only from a loaded scenario, never over the
--- HTTP API, and only for callbacks whose sole upvalue is _ENV.
local function install_gm_buttons()
  addGMFunction("Spring the corsair ambush now", function()
    forge_demo_rt.run("gm:force_ambush", function()
      forge_demo_map.spawn_group("ambush")
      forge_demo_rt.install_dialogues()
      forge_demo_state.vars["alarm"] = 1
      addGMMessage("Ambush sprung manually.")
    end)
  end)
end

--- Walk the scheduler. A "while" loop, not an "if": a long tick or an
--- unpause fires every beat it skipped, in order.
local function tick_beats(t)
  while forge_demo_state.beat_idx <= #beats and t >= beats[forge_demo_state.beat_idx].at do
    local beat = beats[forge_demo_state.beat_idx]
    forge_demo_rt.run("beat " .. beat.id, beat.fn)
    forge_demo_state.beat_idx = forge_demo_state.beat_idx + 1
  end
end

local function tick_rules()
  for _, rule in ipairs(rules) do
    if not (rule.once and rule.fired) then
      local ok, value = pcall(rule.when)
      if ok then
        if value and not rule.was_true then
          forge_demo_rt.run("rule " .. rule.id, rule.fn)
          rule.fired = true
        end
        rule.was_true = value
      else
        print("[forge] rule " .. rule.id .. " predicate failed: " .. tostring(value))
      end
    end
  end
end

function init()
  forge_demo_map.spawn()
  forge_demo_rt.install_dialogues()
  install_gm_buttons()
end

function update(delta)
  tick_beats(getScenarioTime())
  tick_rules()
end
"
`;
