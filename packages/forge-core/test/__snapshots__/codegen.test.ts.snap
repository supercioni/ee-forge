exports[`golden output > matches the committed snapshot > forge_demo_content.lua 1`] = `
"-- GENERATED BY EE FORGE — DO NOT EDIT
-- project forge_demo (content)
-- source  projects/forge_demo/project.json
-- sha256  test-hash
-- target  EE-2026.09.22PR
--
-- Edit the project document and build again. Hand edits here are
-- overwritten on the next build.

-- Returns an existing FactionInfo by name, or nil.
-- Probed against a live EE-2024.12.08 (2026-08-09, ADR-0034 item 2):
-- getFactionInfo() on an unknown name returns nil and does NOT raise,
-- so a plain call is enough and re-running this file is idempotent.
local function existing_faction(name)
  local found = getFactionInfo(name)
  if found ~= nil and found:isValid() then return found end
  return nil
end

-- === Factions ===

local faction_corsairs = existing_faction("Corsairs")
if faction_corsairs == nil then
  faction_corsairs = FactionInfo()
    :setName("Corsairs")
    :setLocaleName("Corsairs")
    :setGMColor(210, 70, 40)
    :setDescription("Raiders working the shipping lanes beyond the Anchorage line. They fly refitted hulls and jump before a response fleet arrives.")
end

-- Faction relations (EE reciprocates automatically)
faction_corsairs:setEnemy(getFactionInfo("Human Navy"))
"
`;

exports[`golden output > matches the committed snapshot > forge_demo_map.lua 1`] = `
"-- GENERATED BY EE FORGE — DO NOT EDIT
-- project forge_demo (map)
-- source  projects/forge_demo/project.json
-- sha256  test-hash
-- target  EE-2026.09.22PR
--
-- Edit the project document and build again. Hand edits here are
-- overwritten on the next build.

forge_demo_map = forge_demo_map or {}
local M = forge_demo_map

M.project = "forge_demo"
-- id -> handle for every object this map has spawned. Logic and orbit
-- targets resolve through here; entries survive destruction (the handle
-- reports isValid() == false), which is what lets a "destroyed" predicate
-- tell "gone" apart from "never spawned".
M.objects = M.objects or {}
-- group id -> array of handles, refreshed on every spawn of that group.
M.groups = M.groups or {}

local function track(created, id, obj)
  M.objects[id] = obj
  created[#created + 1] = obj
  return obj
end

--- Spawn one named group. Returns the handles it created.
function M.spawn_group(name)
  local created = {}
  if name == "core" then
    -- Anchorage approach — the system as the crew finds it
    track(created, "atlantis", PlayerSpaceship()
        :setCallSign("ATLANTIS")
        :setPosition(100, 7600)
        :setRotation(180)
        :setFaction("Human Navy")
        :setTemplate("Atlantis"))
    track(created, "sun", Planet()
        :setCallSign("SU-01")
        :setPosition(0, 0)
        :setDescription("Anchorage primary")
        :setPlanetRadius(4000)
        :setPlanetSurfaceTexture("planets/sun.png"))
    track(created, "anchorage", Planet()
        :setCallSign("PL-01")
        :setPosition(14000, 0)
        :setDescription("Anchorage — habitable, lightly settled")
        :setPlanetRadius(2500)
        :setPlanetSurfaceTexture("planets/planet-earth.png")
        :setPlanetCloudTexture("planets/clouds-1.png")
        :setPlanetAtmosphereTexture("planets/atmosphere.png")
        :setPlanetAtmosphereColor(0.35, 0.55, 1)
        :setAxialRotationTime(120))
    track(created, "anchorage_moon", Planet()
        :setCallSign("PL-02")
        :setPosition(18500, 0)
        :setPlanetRadius(500)
        :setPlanetSurfaceTexture("planets/moon-1.png")
        :setOrbit(forge_demo_map.objects["anchorage"], 1800))
    track(created, "station", SpaceStation()
        :setCallSign("ST-MI-01")
        :setPosition(11000, -2000)
        :setFaction("Human Navy")
        :setDescription("Anchorage Control")
        :setTemplate("Medium Station"))
    track(created, "nebula_veil", Nebula():setCallSign("NB-SG-01"):setPosition(-9000, -6000))
    track(created, "belt_01", Asteroid():setCallSign("AS-BE-01"):setPosition(6500, 5200):setSize(120))
    track(created, "belt_02", Asteroid():setCallSign("AS-BE-01"):setPosition(7400, 4300):setSize(90))
    track(created, "belt_03", Asteroid():setCallSign("AS-BE-01"):setPosition(8100, 5600):setSize(140))
    track(created, "belt_04", Asteroid():setCallSign("AS-BE-01"):setPosition(5900, 4100):setSize(70))
    track(created, "approach_zone", Zone()
        :setCallSign("ZN-QT-01")
        :setPosition(12000, 3000)
        :setPoints(8000, 6000, 16000, 6000, 16000, 500, 8000, 500)
        :setColor(220, 120, 40)
        :setLabel("APPROACH"))
    track(created, "cpuship", CpuShip()
        :setCallSign("SH-01")
        :setPosition(11400, -12200)
        :setFaction("Human Navy")
        :setTemplate("Phobos T3"))
  end
  if name == "ambush" then
    -- Corsair raiding pair — called by the approach trigger
    track(created, "corsair_a", CpuShip()
        :setCallSign("SH-EN-01")
        :setPosition(15500, 4200)
        :setRotation(200)
        :setFaction("Corsairs")
        :setTemplate("Corsair Mk2")
        :setAI("fighter"))
    track(created, "corsair_b", CpuShip()
        :setCallSign("SH-EN-01")
        :setPosition(16200, 2800)
        :setRotation(210)
        :setFaction("Corsairs")
        :setTemplate("Corsair Mk1")
        :setAI("evasion"))
  end
  M.groups[name] = created
  return created
end

--- Spawn every group marked on_start, in declaration order.
--- Returns all handles created, so the caller can track them.
function M.spawn()
  local all = {}
  local start_groups = { "core" }
  for _, name in ipairs(start_groups) do
    for _, obj in ipairs(M.spawn_group(name)) do
      all[#all + 1] = obj
    end
  end
  return all
end

--- Destroy every object this map spawned and forget the handles.
function M.wipe()
  for id, obj in pairs(M.objects) do
    if obj ~= nil and obj:isValid() then obj:destroy() end
    M.objects[id] = nil
  end
  for name, _ in pairs(M.groups) do M.groups[name] = nil end
end
"
`;

