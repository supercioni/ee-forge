    "rules": [
      {
        "id": "r_kill_a",
        "label": "A raider down",
        "once": false,
        "when": {
          "kind": "group_destroyed",
          "groupId": "a_raiders"
        },
        "conditions": [],
        "actions": [
          {
            "kind": "add_variable",
            "name": "kills_a",
            "delta": 1
          },
          {
            "kind": "damage_hull",
            "target": {
              "ref": "object",
              "objectId": "depot"
            },
            "amount": 10
          },
          {
            "kind": "ship_log",
            "text": "The raider of sector A is down.",
            "color": "white"
          }
        ]
      },
      {
        "id": "r_jump_1",
        "label": "Jump A to B",
        "once": false,
        "when": {
          "kind": "variable_equals",
          "name": "go_b",
          "value": 1
        },
        "conditions": [
          {
            "kind": "current_sector",
            "sectorId": "sys-a"
          }
        ],
        "actions": [
          {
            "kind": "change_sector",
            "sectorId": "sys-b",
            "arrivalMarkerId": "arrive_b",
            "rotation": null
          },
          {
            "kind": "add_variable",
            "name": "jumps",
            "delta": 1
          },
          {
            "kind": "damage_hull",
            "target": {
              "ref": "object",
              "objectId": "depot"
            },
            "amount": 1
          },
          {
            "kind": "set_variable",
            "name": "go_b",
            "value": 0
          },
          {
            "kind": "ship_log",
            "text": "Arrived in sector B.",
            "color": "white"
          }
        ]
      },
      {
        "id": "r_jump_2",
        "label": "Jump B to A",
        "once": false,
        "when": {
          "kind": "variable_equals",
          "name": "go_a",
          "value": 1
        },
        "conditions": [
          {
            "kind": "current_sector",
            "sectorId": "sys-b"
          }
        ],
        "actions": [
          {
            "kind": "change_sector",
            "sectorId": "sys-a",
            "arrivalMarkerId": "arrive_a",
            "rotation": 180
          },
          {
            "kind": "add_variable",
            "name": "jumps",
            "delta": 1
          },
          {
            "kind": "damage_hull",
            "target": {
              "ref": "object",
              "objectId": "depot"
            },
            "amount": 1
          },
          {
            "kind": "set_variable",
            "name": "go_a",
            "value": 0
          },
          {
            "kind": "ship_log",
            "text": "Back in sector A.",
            "color": "white"
          }
        ]
      },
      {
        "id": "r_jump_3",
        "label": "Jump A to B again",
        "once": false,
        "when": {
          "kind": "variable_equals",
          "name": "go_b2",
          "value": 1
        },
        "conditions": [
          {
            "kind": "current_sector",
            "sectorId": "sys-a"
          }
