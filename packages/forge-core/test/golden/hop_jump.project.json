        "actions": [
          {
            "kind": "change_sector",
            "sectorId": "sys-b",
            "arrivalMarkerId": "arrive_b",
            "rotation": 0
          },
          {
            "kind": "add_variable",
            "name": "jumps",
            "delta": 1
          },
          {
            "kind": "damage_hull",
            "target": {
              "ref": "object",
              "objectId": "depot"
            },
            "amount": 1
          },
          {
            "kind": "set_variable",
            "name": "go_b2",
            "value": 0
          },
          {
            "kind": "ship_log",
            "text": "Arrived in sector B again.",
            "color": "white"
          }
        ]
      },
