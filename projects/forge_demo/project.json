  "logic": {
    "variables": [
      {
        "name": "alarm",
        "initial": 0
      },
      {
        "name": "briefed",
        "initial": false
      }
    ],
    "beats": [
      {
        "id": "arrival",
        "label": "Arrival — Anchorage Control hails the ship",
        "at": 0,
        "actions": [
          {
            "kind": "global_message",
            "text": "ANCHORAGE CONTROL: Atlantis, you are cleared to the inner approach.",
            "timeoutS": null
          },
          {
            "kind": "ship_log",
            "text": "Cleared to inner approach. Corsair activity reported in the belt.",
            "color": "yellow"
          },
          {
            "kind": "set_variable",
            "name": "briefed",
            "value": true
          }
        ]
      },
      {
        "id": "warning",
        "label": "T+45 — Control repeats the corsair warning",
        "at": 45,
        "actions": [
          {
            "kind": "banner",
            "text": "CORSAIR ACTIVITY REPORTED — INNER APPROACH"
          },
          {
            "kind": "gm_message",
            "text": "Player has been warned about the corsairs."
          }
        ]
      }
    ],
    "rules": [
      {
        "id": "spring_ambush",
        "label": "Player enters the approach zone — corsairs decloak from the belt",
        "when": {
          "kind": "player_in_zone",
          "zoneId": "approach_zone"
        },
        "conditions": [
          {
            "kind": "variable_equals",
            "name": "briefed",
            "value": true
          }
        ],
        "once": true,
        "actions": [
          {
            "kind": "spawn_group",
            "groupId": "ambush"
          },
          {
            "kind": "set_alert_level",
            "level": "red"
          },
          {
            "kind": "global_message",
            "text": "Two contacts closing from the belt. Corsairs!",
            "timeoutS": 8
          },
          {
            "kind": "set_variable",
            "name": "alarm",
            "value": 1
          },
          {
            "kind": "order_attack",
            "target": {
              "ref": "group",
              "groupId": "ambush"
            },
            "objectId": "atlantis"
          },
          {
            "kind": "order_fly_formation",
            "target": {
              "ref": "object",
              "objectId": "corsair_b"
            },
            "leaderId": "corsair_a",
            "offset": {
              "x": 900,
              "y": -600
            }
          },
          {
            "kind": "set_object_variable",
            "target": {
              "ref": "group",
              "groupId": "ambush"
            },
            "name": "alerted",
            "value": true
          }
        ]
      },
      {
        "id": "ambush_cleared",
        "label": "Both corsairs destroyed — the approach is clear",
        "when": {
          "kind": "group_destroyed",
          "groupId": "ambush"
        },
        "conditions": [
          {
            "kind": "variable_at_least",
            "name": "alarm",
            "value": 1
          }
        ],
        "once": true,
        "actions": [
          {
            "kind": "global_message",
            "text": "ANCHORAGE CONTROL: Approach is clear. Well flown, Atlantis.",
            "timeoutS": null
          },
          {
            "kind": "ship_log",
            "text": "Corsair pair destroyed.",
            "color": "green"
          },
          {
            "kind": "victory",
            "faction": "Human Navy"
          }
        ]
      },
      {
        "id": "hull_critical",
        "label": "Hull below 30% — Control offers the station for repairs",
        "when": {
          "kind": "player_hull_below",
          "fraction": 0.3
        },
        "conditions": [],
        "once": true,
        "actions": [
          {
            "kind": "global_message",
            "text": "ANCHORAGE CONTROL: Atlantis, dock at Anchorage Control for repairs.",
            "timeoutS": null
          },
          {
            "kind": "ship_log",
            "text": "Hull critical. Repair dock offered.",
            "color": "red"
          }
        ]
      },
      {
        "id": "wing_breaks_off",
        "label": "Alerted wing breaks off when the Atlantis is hurt",
        "when": {
          "kind": "player_hull_below",
          "fraction": 0.4
        },
        "conditions": [
          {
            "kind": "object_variable_equals",
            "objectId": "corsair_a",
            "name": "alerted",
            "value": true
          }
        ],
        "once": true,
        "actions": [
          {
            "kind": "order_retreat",
            "target": {
              "ref": "group",
              "groupId": "ambush"
            },
            "objectId": "anchorage"
          },
          {
            "kind": "global_message",
            "text": "The corsair wing is breaking off.",
            "timeoutS": 6
          }
        ]
      }
    ],
    "gmButtons": [
      {
        "id": "force_ambush",
        "label": "Spring the corsair ambush now",
        "actions": [
          {
            "kind": "spawn_group",
            "groupId": "ambush"
          },
          {
            "kind": "set_variable",
            "name": "alarm",
            "value": 1
          },
          {
            "kind": "gm_message",
            "text": "Ambush sprung manually."
          }
        ]
      }
    ]
  }
}
